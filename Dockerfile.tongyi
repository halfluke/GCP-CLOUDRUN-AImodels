FROM ollama/ollama:latest

ARG GGUF_FILE=Alibaba-NLP_Tongyi-DeepResearch-30B-A3B-IQ2_S.gguf
ARG GGUF_URL=https://huggingface.co/bartowski/Alibaba-NLP_Tongyi-DeepResearch-30B-A3B-GGUF/resolve/main/Alibaba-NLP_Tongyi-DeepResearch-30B-A3B-IQ2_S.gguf
ARG OLLAMA_MODEL_NAME=tongyi-deepresearch-iq2s

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /models && \
    echo "==> Downloading GGUF (~8.7 GB). Cloud Build may show no progress for 15-40 min." && \
    curl -fL --retry 5 --retry-delay 15 --retry-all-errors \
      -o "/models/${GGUF_FILE}" "${GGUF_URL}" && \
    BYTES="$(wc -c < "/models/${GGUF_FILE}")" && \
    echo "==> Downloaded ${BYTES} bytes" && \
    test "${BYTES}" -gt 8000000000

COPY Modelfile.tongyi /tmp/Modelfile

RUN sed -i "s|Alibaba-NLP_Tongyi-DeepResearch-30B-A3B-IQ2_S.gguf|${GGUF_FILE}|g" /tmp/Modelfile && \
    echo "==> Creating Ollama model ${OLLAMA_MODEL_NAME} (may take several minutes)..." && \
    ollama serve & sleep 8 && \
    ollama create "${OLLAMA_MODEL_NAME}" -f /tmp/Modelfile && \
    pkill ollama || true && \
    echo "==> Ollama model ${OLLAMA_MODEL_NAME} created"

EXPOSE 11434
ENTRYPOINT ["/usr/bin/ollama", "serve"]
